<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureHomes">

        <!-- Login Screen (Launcher) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.wizard.AddDeviceActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.wizard.GuidedWizardActivity"
            android:exported="false"
            android:parentActivityName=".ui.wizard.AddDeviceActivity" />

        <activity
            android:name=".ui.wizard.UnguidedFormActivity"
            android:exported="false"
            android:parentActivityName=".ui.wizard.AddDeviceActivity" />

        <activity
            android:name=".ui.details.DeviceDetailsActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.survey.SurveyActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.analytics.AnalyticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

    </application>

</manifest>
